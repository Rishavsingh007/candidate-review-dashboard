# Copy to .env and adjust for local development (never commit .env)

# Backend
JWT_SECRET=dummy-jwt-secret-for-local-dev-only
DATABASE_URL=sqlite:///./app.db
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Frontend (used by Vite — browser calls API on host port 8000)
VITE_API_URL=http://localhost:8000
